# --- Robinhood Chain deployment ---
# Get the current RPC URL and chain ID from https://docs.robinhood.com/chain
ROBINHOOD_RPC_URL=https://robinhood-mainnet.g.alchemy.com/v2/YOUR_ALCHEMY_KEY
ROBINHOOD_CHAIN_ID=

# Fallback testnet while you don't have funds on Robinhood Chain yet
ARBITRUM_SEPOLIA_RPC_URL=https://arb-sepolia.g.alchemy.com/v2/YOUR_ALCHEMY_KEY

DEPLOYER_PRIVATE_KEY=0xyour_deployer_wallet_private_key

# Where the deployed contract will point tokenURI() to
METADATA_BASE_URI=https://your-backend.example.com/api/metadata/
